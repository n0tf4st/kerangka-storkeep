# Salin ke .env untuk pemakaian lokal. JANGAN isi nilai di file ini (file ini di-push).
# Sesuaikan isinya dengan stack yang dipilih saat sesi pertama (framework, bahasa, database).

# --- runtime ---
APP_ENV=production
# PORT=3000

# --- database (pakai salah satu, hapus yang tidak dipakai) ---
# DATABASE_URL=
# MYSQL_URL=
# SQLITE_PATH=./data/app.db

# --- kredensial layanan eksternal ---
# API_KEY=
# API_SECRET=

# --- opsional ---
LOG_LEVEL=info
