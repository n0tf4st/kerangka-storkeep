# Template env. Salin menjadi .env untuk lokal. JANGAN isi nilai di file ini (file ini di-push).
# Hapus baris/section yang tidak dipakai stack-mu. Semua contoh dikomentari.

# ===== runtime =====
APP_ENV=production
APP_URL=http://localhost:3000
# APP_PORT=3000
# PORT=3000
# TZ=Asia/Jakarta

# ===== Node / JS =====
# NODE_ENV=development

# ===== database (pilih satu) =====
# DATABASE_URL=postgresql://user:pass@host:5432/db        # PostgreSQL / Neon / Supabase
# MYSQL_URL=mysql://user:pass@host:3306/db?pool=3         # MySQL / MariaDB / PlanetScale
# SQLITE_PATH=./data/app.db                               # SQLite
# SQLSERVER_URL=Server=host;Database=db;User Id=sa;Password=pass;   # SQL Server
# MONGO_URL=mongodb://user:pass@host:27017/db             # MongoDB
# REDIS_URL=redis://user:pass@host:6379                   # cache / queue / session

# ===== auth =====
# JWT_SECRET=
# SESSION_SECRET=
# API_KEY=
# API_SECRET=
# OAUTH_GOOGLE_ID=
# OAUTH_GOOGLE_SECRET=
# OAUTH_GITHUB_ID=
# OAUTH_GITHUB_SECRET=

# ===== bot chat (hapus bila bukan bot) =====
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_ID=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ===== storage =====
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# CLOUDINARY_URL=

# ===== email =====
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ===== deploy / platform (diisi di dashboard, bukan di file ini) =====
# HEROKU_API_KEY=
# VERCEL_TOKEN=
# CLOUDFLARE_API_TOKEN=
# FLY_API_TOKEN=

# ===== observability =====
# LOG_LEVEL=info
# SENTRY_DSN=

# ===== fitur opsional =====
# MAINTENANCE=0
# RATE_LIMIT_PER_MENIT=60
# CLEANUP_HARI=7
